# Email OSINT Enricher — Configuration
# Copy to config.yaml and customize.

providers:
  # ── Core providers (enabled by default) ──────────────────────────────────
  holehe:
    enabled: true
    timeout_seconds: 120

  blackbird:
    enabled: true
    timeout_seconds: 180

  maigret:
    enabled: true
    timeout_seconds: 300  # Maigret is slower — deep OSINT

  sherlock:
    enabled: false  # Fallback for Maigret — enable if needed
    timeout_seconds: 120

  phone_extractor:
    enabled: true
    timeout_seconds: 30

  # ── Optional providers ───────────────────────────────────────────────────
  emailrep:
    enabled: true
    timeout_seconds: 60
    api_key_env: EMAILREP_API_KEY  # Optional — works unauthenticated too

  mosint:
    enabled: false   # Requires mosint Go binary in PATH
    timeout_seconds: 180
    command: mosint

  emailcrawlr:
    enabled: false   # Requires EMAILCRAWLR_API_KEY
    timeout_seconds: 60
    api_key_env: EMAILCRAWLR_API_KEY

batch:
  concurrency: 3        # Parallel provider calls
  delay_seconds: 1.5    # Delay between emails
  max_retries: 2        # Retries per provider per email

output:
  save_raw_json: true    # Save raw provider JSON in output/raw/
  write_xlsx: true
  write_csv: true
  write_jsonl: true

logging:
  level: INFO
  mask_emails: true      # Mask emails in log output
